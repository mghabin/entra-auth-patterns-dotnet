root = true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
indent_size = 4
max_line_length = 140

# C# style
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_lambdas = true:silent
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming
dotnet_naming_rule.private_members_with_underscore.symbols  = private_fields
dotnet_naming_rule.private_members_with_underscore.style    = prefix_underscore
dotnet_naming_rule.private_members_with_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.prefix_underscore.capitalization = camel_case
dotnet_naming_style.prefix_underscore.required_prefix = _

# Suppressions tuned for this sample (controllers/DTO conventions)
dotnet_diagnostic.CA1515.severity = none      # Consider making public types internal — not for ASP.NET controllers
dotnet_diagnostic.CA1812.severity = none      # Avoid uninstantiated internal classes (false-positive on minimal API/DI)
dotnet_diagnostic.CA1861.severity = none      # Avoid constant arrays as args (noisy in config code)
dotnet_diagnostic.CA1716.severity = none      # Namespace conflicts with language keyword — false-positive for "Shared"
dotnet_diagnostic.CA1062.severity = none      # Public method null-arg checks — NRT covers this
dotnet_diagnostic.MA0004.severity = suggestion # ConfigureAwait — apps don't need it; libs do
dotnet_diagnostic.MA0051.severity = suggestion # Method too long
dotnet_diagnostic.MA0016.severity = none       # Prefer interface type — not for this sample
dotnet_diagnostic.S1144.severity  = suggestion # Unused private members (false positives w/ DI)
dotnet_diagnostic.S6605.severity  = none       # Use Exists instead of Contains — taste
dotnet_diagnostic.MA0048.severity = none       # File name must match type name — we group small related types
dotnet_diagnostic.S1075.severity  = none       # Hard-coded URIs — fine in appsettings examples

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
